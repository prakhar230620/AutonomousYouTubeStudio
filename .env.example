# Dashboard login / signed session
STUDIO_DASHBOARD_PASSWORD=
STUDIO_SESSION_SECRET=
STUDIO_API_SECRET=

# Script generation
OPENAI_API_KEY=
OPENAI_SCRIPT_MODEL=

# Supabase (server-only service role key; never expose to browser)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Durable workflow
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=1

# Private S3-compatible object storage (R2/S3)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Existing Voiceover Studio: keep unset until the Connect/MessagePack
# request and response protocol has been verified against its client.
VOICEOVER_API_URL=
VOICEOVER_API_TOKEN=

# Remote Remotion/FFmpeg rendering worker
RENDER_WORKER_URL=
RENDER_WORKER_TOKEN=

# YouTube Data API OAuth; channel owner must authorize the app
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=
YOUTUBE_PUBLISHING_ENABLED=false
YOUTUBE_DEFAULT_PRIVACY_STATUS=private
